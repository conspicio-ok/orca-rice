################
### MONITORS ###
################

# See https://wiki.hyprland.org/Configuring/Monitors/
#
# You can list your device with the following command
# hyprctl monitors all

monitor = desc: HKC OVERSEAS LIMITED 27E3Q, 2560x1440@144, 0x0, 1
#monitor= HDMI-A-1,1920x1080@60,0x0, 1, mirror, DP-1
#monitor= ID 1,1920x1080@60,640x1440, 1

monitor = , preferred, auto, 1
